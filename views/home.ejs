<%- include('partials/navbar') %>
<main>
  <div
    class="container-fluid bg-trasparent my-4 p-3"
    style="position: relative"
  >
    <div class="row d-flex mb-4 justify-content-center">
      <% for(let category of categories){ %>
      <div class="col-2 card m-2 p-2 bg-purple">
        <a
          href="/api/category/<%=category.id%>"
          class="text-decoration-none text-white text-center link-light"
        >
          <%=category.name %></a
        >
      </div>
      <% } %>
    </div>
    <div class="row row-cols-1 row-cols-xs-2 row-cols-sm-2 row-cols-lg-4 g-3">
      <% for(let product of products){ %>
      <div class="col">
        <div class="card h-100 shadow-sm">
          <img
            style="width: auto; height: 295px"
            src="<%=product.image  %>"
            class="card-img-top img-fluid"
            alt="..."
          />
          <div class="card-body d-flex flex-column">
            <div class="clearfix mb-3">
              <span class="float-start badge rounded-pill bg-primary"
                ><%=product.name.slice(0,15) %></span
              >
              <span class="float-end price-hp"><%=product.price %>&euro;</span>
            </div>
            <h5 class="card-title"><%=product.description %></h5>
            <div class="text-center my-4 mt-auto">
              <a href="/api/products/<%=product.id %>" class="btn btn-warning"
                >Check offer</a
              >
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</main>
<%-include("partials/footer") %>
